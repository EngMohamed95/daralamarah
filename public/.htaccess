<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Serve actual physical files (images, css, js, mp4, etc.) directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Rewrite everything else (including /projects, /services, /why, etc.) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

